# Weaviate Cloud Service (Vector DB)
WEAVIATE_URL=https://your-cluster.weaviate.cloud
WEAVIATE_API_KEY=your_weaviate_api_key
WEAVIATE_CLASS_NAME=Documents
WEAVIATE_GRPC=grpc-your-cluster.weaviate.cloud
# AWS Configuration
AWS_PROFILE=rag-qamaq
AWS_PROFILE=profile-dev2
AWS_REGION=us-east-1
# AWS Access Keys (optional, use when no profile is available or in EC2)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Embeddings (Amazon Titan Text Embeddings V2)
EMBEDDINGS_PROVIDER=aws
EMBEDDINGS_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDINGS_MODEL_ID=cohere.embed-multilingual-v3
EMBEDDINGS_REGION=us-east-1
EMBEDDINGS_DIMENSIONS=1024
# LLM
LLM_PROVIDER=aws
LLM_REGION=us-east-1
# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_RELOAD=False
# Logging
LOG_LEVEL=INFO
# RAG Configuration
# Orchestrator Model Configuration
ORCHESTRATOR_MODEL_ID=amazon.nova-micro-v1:0
ORCHESTRATOR_MODEL_ID=openai.gpt-oss-20b-1:0
ORCHESTRATOR_MAX_TOKENS=1024
ORCHESTRATOR_TEMPERATURE=0.1
ORCHESTRATOR_TOP_P=0.9
# Recontextualizer Model Configuration
RECONTEXTUALIZER_MODEL_ID=us.meta.llama4-maverick-17b-instruct-v1:0
# Transcribe Configuration
TRANSCRIBE_LANGUAGE_CODE=es-ES
TRANSCRIBE_SAMPLE_RATE=16000
TRANSCRIBE_MEDIA_ENCODING=pcm
# OpenAI Configuration (for gpt-4o-mini-transcribe)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_TIMEOUT=60
# SQL Server Database Configuration
DB_SERVER=localhost
DB_DATABASE=staging
DB_USERNAME=sa
DB_PASSWORD=YourPassword123!
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_PORT=1433
DB_TRUSTED_CONNECTION=False
# Environment
ENVIRONMENT=development
# JWT Configuration
JWT_SECRET_KEY=qamaq-rag-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRATION_MINUTES=2880
# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DynamoDB Configuration
DYNAMODB_TABLE_MESSAGES=ia-fractal-messages-staging
#S3 Buckets
S3_PDFS_BUCKET=pdfs-bucket-name
S3_INGEST_RESULTS_BUCKET=ingest-results-bucket-name
S3_LOGOS_BUCKET=logos-bucket
# n8n Webhook Configuration
N8N_CC_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-path
N8N_CC_JWT_SECRET=your-n8n-jwt-secret-key-minimum-32-chars
