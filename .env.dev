# Weaviate Cloud Service (Vector DB)
WEAVIATE_URL=https://your-cluster.weaviate.cloud
WEAVIATE_API_KEY=your_weaviate_api_key
WEAVIATE_CLASS_NAME=Documents
WEAVIATE_GRPC=grpc-your-cluster.weaviate.cloud
# AWS Configuration
AWS_PROFILE=aws-profile
AWS_REGION=us-east-1
# AWS Access Keys (optional, use when no profile is available or in EC2)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Embeddings (Amazon Titan Text Embeddings V2)
EMBEDDINGS_PROVIDER=aws
EMBEDDINGS_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDINGS_REGION=us-east-1
EMBEDDINGS_DIMENSIONS=1024
# LLM (Meta Llama3)
LLM_PROVIDER=aws
LLM_MODEL_ID=us.anthropic.claude-3-haiku-20240307-v1:0
LLM_MODEL_ID=us.meta.llama3-1-8b-instruct-v1:0
LLM_REGION=us-east-1
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.7
# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_RELOAD=False
# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
# RAG Configuration
RAG_MAX_CONTEXT_LENGTH=4000
RAG_TOP_K_RESULTS=5
RAG_SIMILARITY_THRESHOLD=0.4
# SQL Server Database Configuration
DB_SERVER=localhost
DB_DATABASE=staging
DB_USERNAME=sa
DB_PASSWORD=YourPassword123!
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_PORT=1433
DB_TRUSTED_CONNECTION=False
# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Environment
ENVIRONMENT=development
# JWT Configuration
JWT_SECRET_KEY=qamaq-rag-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRATION_HOURS=8
# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Document Processing Configuration
CARGA_CONOCIMIENTO_PATH=../CargaConocimiento_iA
PROCESSING_VENV_PATH=venv/bin/python
PROCESSING_TIMEOUT_SECONDS=3600
UPLOAD_DIRECTORY=company_files/files